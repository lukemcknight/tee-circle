# Server-side Vercel Function setting. This Edge Function must be anonymous and
# accept POST { "schemaVersion": 1, "inviteToken": "..." }.
PUBLIC_PREVIEW_ENDPOINT=https://YOUR_PROJECT.supabase.co/functions/v1/preview-trip-v1

# Required in production. Set the same random 32-byte-or-longer value in
# Vercel and as a Supabase Edge Function secret. It authenticates the viewer
# identity Vercel forwards for per-invitation rate limiting; never expose it as
# a VITE_* variable.
PUBLIC_PREVIEW_PROXY_SECRET=replace-with-a-random-server-only-secret

# Alternatively, the server derives the URL above when this is already present.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Optional local-development bypass. Production browsers should use /api/preview
# so the Vercel privacy filter remains between the Edge response and the page.
# VITE_PUBLIC_PREVIEW_ENDPOINT=http://127.0.0.1:54321/functions/v1/preview-trip-v1
