{
  "expo": {
    "name": "Tee Circle",
    "slug": "tee-circle",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.teecircle.app",
      "buildNumber": "9",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSUserNotificationUsageDescription": "Tee Circle sends notifications to let you know about friend requests and round updates.",
        "NSSpeechRecognitionUsageDescription": "Tee Circle uses speech recognition so you can search for tee times by voice.",
        "NSMicrophoneUsageDescription": "Tee Circle uses the microphone so you can say the tee time you're looking for.",
        "NSPhotoLibraryUsageDescription": "Tee Circle lets you choose a photo from your library for your profile picture.",
        "NSCameraUsageDescription": "Tee Circle lets you take a photo for your profile picture.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7CCB8A"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tee Circle uses your location to find golf courses near you."
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.350395562792-439vqodi4elipemhtr0a5vk45e2kk086"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Tee Circle uses the microphone so you can say the tee time you're looking for.",
          "speechRecognitionPermission": "Tee Circle uses speech recognition so you can search for tee times by voice."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "90376455-36ff-4a51-a885-809c46fb5955"
      }
    },
    "owner": "ljmcknight"
  }
}